# Shared Updater Server - deploy/updater.caddy
# <Oort.dlugosz.enterprises/john/Shared-Updater-Server> - see LICENCE.

# Merge the following logger definitions into the existing global options.
{
    log default {
        exclude http.log.error.updater
    }
    log updater_runtime {
        include http.log.error.updater
        output stderr
        format filter {
            wrap json
            fields {
                request delete
            }
        }
    }
}

# Replace this example hostname and merge the handlers into the site's config.
updates.example.invalid {
    log updater
    log_skip /updchk/*
    handle /updchk/* {
        reverse_proxy 127.0.0.1:8080 {
            lb_retries 0
            transport http {
                versions 1.1
                dial_timeout 2s
                response_header_timeout 25s
            }
        }
    }
    redir /downloads /downloads/ 308
    redir /downloads/previous-versions /downloads/previous-versions/ 308
    @download_index path /downloads/ /downloads/index.html /downloads/previous-versions/ /downloads/previous-versions/index.html
    handle @download_index {
        root * /srv/www/updater-downloads
        uri strip_prefix /downloads
        file_server
    }
    handle_path /downloads/previous-versions/launcher/* {
        root * /srv/www/updater-downloads/launcher
        file_server browse {
            index ""
            hide .*
        }
    }
    handle_path /downloads/previous-versions/shared-updater/* {
        root * /srv/www/updater-downloads/shared-updater
        file_server browse {
            index ""
            hide .*
        }
    }
    handle_path /downloads/launcher/* {
        root * /srv/www/updater-downloads/launcher
        file_server
    }
    handle_path /downloads/shared-updater/* {
        root * /srv/www/updater-downloads/shared-updater
        file_server
    }
    handle {
        respond 404
    }
}
