cmake_minimum_required(VERSION 3.30)

set(build_version "${PROJECT_VERSION}")
set(build_commit "unknown")
set(build_tree "unknown")
set(build_tag "")
if(GIT_EXECUTABLE AND EXISTS "${SOURCE_DIR}/.git")
    file(REAL_PATH "${SOURCE_DIR}" source_root)
    set(git_options --no-optional-locks -C "${source_root}")
    if(TRUST_SHARED_CHECKOUT)
        list(APPEND git_options -c "safe.directory=${source_root}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" ${git_options} status
                    --porcelain=v2 --branch --no-ahead-behind --untracked-files=normal --ignore-submodules=none
        RESULT_VARIABLE git_result OUTPUT_VARIABLE git_status ERROR_QUIET)
    if(git_result STREQUAL "0" AND git_status MATCHES "(^|\n)# branch\\.oid ([0-9a-f]+)[\r\n]")
        set(build_commit "${CMAKE_MATCH_2}")
        set(build_tree "clean")
        if(git_status MATCHES "\n[12u?] ")
            set(build_tree "dirty")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" ${git_options} describe --tags --exact-match "${build_commit}"
            RESULT_VARIABLE tag_result OUTPUT_VARIABLE exact_tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(tag_result STREQUAL "0")
            set(build_tag "${exact_tag}")
            set(build_version "${build_tag}")
        endif()
    endif()
endif()

set(build_status "development")
set(build_variant "${BUILD_VARIANT}")
if(NOT BUILD_SANITIZER STREQUAL "none")
    set(build_variant "sanitizer-${BUILD_SANITIZER}")
endif()
string(TOUPPER "${BUILD_CONFIG}" config_upper)
if(build_tree STREQUAL "clean" AND NOT build_tag STREQUAL "" AND build_variant STREQUAL "normal"
   AND config_upper MATCHES "^(RELEASE|RELWITHDEBINFO|MINSIZEREL)$")
    set(build_status "release")
endif()
if(build_tag STREQUAL "")
    set(build_tag "-")
endif()
if(BUILD_CONFIG STREQUAL "")
    set(BUILD_CONFIG "unspecified")
endif()
string(TIMESTAMP build_date "%Y-%m-%d" UTC)

set(report "")
function(append_report_field name prefix value)
    string(APPEND report "${prefix}")
    string(LENGTH "${report}" offset)
    string(LENGTH "${value}" length)
    string(APPEND report "${value}")
    set(report "${report}" PARENT_SCOPE)
    set("${name}_slice" "${offset}, ${length}" PARENT_SCOPE)
endfunction()

# Record offsets into the report before escaping it for the C++ literal.
append_report_field(version "Shared Updater Server " "${build_version}")
append_report_field(status "\nStatus: " "${build_status}")
append_report_field(configuration "\nBuild: " "${BUILD_CONFIG}")
append_report_field(variant " (" "${build_variant}")
append_report_field(date ")\nBuild date: " "${build_date}")
append_report_field(git_commit " UTC\nGit commit: " "${build_commit}")
append_report_field(git_tree " (" "${build_tree}")
append_report_field(git_tag ")\nGit tag: " "${build_tag}")
string(LENGTH "${report}" report_size)
string(REPLACE "\\" "\\\\" escaped_report "${report}")
string(REPLACE "\n" "\\n" escaped_report "${escaped_report}")
string(REPLACE "\r" "\\r" escaped_report "${escaped_report}")
string(REPLACE "\t" "\\t" escaped_report "${escaped_report}")

# Keep the source's timestamp when another build sees the same metadata.
configure_file("${CMAKE_CURRENT_LIST_DIR}/build_info.cpp.in" "${OUTPUT_FILE}" @ONLY ESCAPE_QUOTES)
