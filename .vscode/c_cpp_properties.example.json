{
  "env": {
    "stagingHeaders": "${workspaceFolder}/out/intellisense/vps-stage"
  },
  "configurations": [
    {
      "name": "VPS Local GCC 16.2",
      "compilerPath": "",
      "intelliSenseMode": "linux-gcc-x64",
      "cppStandard": "c++26",
      "defines": [
        "_GNU_SOURCE=1",
        "NDEBUG",
        "TOML_HEADER_ONLY=0",
        "TOML_SHARED_LIB=1"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${stagingHeaders}/usr/include/libxml2",
        "${stagingHeaders}/gcc-16.2.0/include/c++/16.2.0",
        "${stagingHeaders}/gcc-16.2.0/include/c++/16.2.0/x86_64-linux-gnu",
        "${stagingHeaders}/gcc-16.2.0/include/c++/16.2.0/backward",
        "${stagingHeaders}/gcc-16.2.0/lib/gcc/x86_64-linux-gnu/16.2.0/include",
        "${stagingHeaders}/gcc-16.2.0/lib/gcc/x86_64-linux-gnu/16.2.0/include-fixed/x86_64-linux-gnu",
        "${stagingHeaders}/gcc-16.2.0/lib/gcc/x86_64-linux-gnu/16.2.0/include-fixed",
        "${stagingHeaders}/usr/local/include",
        "${stagingHeaders}/gcc-16.2.0/include",
        "${stagingHeaders}/usr/include/x86_64-linux-gnu",
        "${stagingHeaders}/usr/include"
      ]
    }
  ],
  "version": 4
}
